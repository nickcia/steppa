// App identity: the name people see is set here.
//
// The bundle ID and iCloud container can't change once the app ships, so they deliberately
// don't include the app name. Set BUNDLE_ID_PREFIX to your own reverse-domain prefix.
APP_DISPLAY_NAME = TrackStar
BUNDLE_ID_PREFIX = io.github.nickcia
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).runcoach

// Your Apple Developer team ID (needed to run on a device). Set it in Config/Local.xcconfig,
// which isn't committed; see Config/Local.xcconfig.example.
DEVELOPMENT_TEAM =

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 3

// iCloud sync (CloudKit private database). Needs DEVELOPMENT_TEAM and the container below registered in
// your developer account. Set to YES to turn it on; with NO, data stays on the device only.
ENABLE_ICLOUD = NO
ICLOUD_CONTAINER = iCloud.$(BUNDLE_ID_PREFIX).runcoach

ENTITLEMENTS_ICLOUD_YES = Config/TrackStar-iCloud.entitlements
ENTITLEMENTS_ICLOUD_NO = Config/TrackStar.entitlements
CODE_SIGN_ENTITLEMENTS = $(ENTITLEMENTS_ICLOUD_$(ENABLE_ICLOUD))
CONDITION_ICLOUD_YES = ICLOUD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(CONDITION_ICLOUD_$(ENABLE_ICLOUD))
INFOPLIST_ICLOUD_YES = Config/Info-iCloud.plist
INFOPLIST_ICLOUD_NO = Config/Info.plist
INFOPLIST_FILE = $(INFOPLIST_ICLOUD_$(ENABLE_ICLOUD))

// "Sign in with Intervals.icu" (sends workouts on to Garmin, COROS, Suunto and Wahoo). Register an OAuth app at
// intervals.icu/oauth/apply, mark it as a public client, and add the redirect URI
// <your bundle ID in lower case>://intervals-oauth. Leave blank to connect with a personal API key instead.
// 1716 is TrackStar's own client, registered for io.github.nickcia.runcoach. Forks with their own bundle ID should
// set their own (or a blank one) in Local.xcconfig, since Intervals.icu only returns to the registered redirect.
INTERVALS_CLIENT_ID = 1716

// Strava: phone runs upload straight to the athlete's Strava account. Register an API app at
// strava.com/settings/api with STRAVA_CALLBACK_DOMAIN as its "Authorization Callback Domain". The client ID is public;
// put the client secret in Config/Local.xcconfig (not committed): STRAVA_CLIENT_SECRET = ...
// With any of the three blank, the Strava option is hidden.
STRAVA_CLIENT_ID = 295676
STRAVA_CLIENT_SECRET =
STRAVA_CALLBACK_DOMAIN = nickcia.github.io

// Shown when turning on "Show my plan in Calendar". Adding a single workout uses iOS's own sheet and needs no access.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = Your training plan is added to its own calendar and kept up to date as it changes. Only that calendar is ever changed.

// Shown when asking for Apple Health access. The app reads runs, and saves only runs recorded on the phone (guided runs).
INFOPLIST_KEY_NSHealthUpdateUsageDescription = Runs you record on your iPhone with a guided run are saved to Apple Health as running workouts, with their distance and route, so they count everywhere and tick off your plan.
INFOPLIST_KEY_NSHealthShareUsageDescription = Your runs are read from Apple Health (including runs from Apple Watch, Garmin, Coros and other apps that sync to Health) to tick off planned workouts and adapt your plan. Nothing leaves your device.

// Shown when starting a guided run on the phone. Location keeps the spoken cues going with the screen locked, and measures
// distance. It's only used during a guided run, and never leaves the phone.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = During a guided run, your location measures distance and keeps the spoken cues going with the screen locked. It's only used while a run is in progress and never leaves your phone.

// Personal overrides (team ID, and a different prefix for forks). Optional and not committed.
#include? "Local.xcconfig"
