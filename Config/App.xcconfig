// App identity. "Steppa" is a working title: change the display name here.
//
// The bundle ID and iCloud container can't change once the app ships, so they deliberately
// don't include the app name. Set BUNDLE_ID_PREFIX to your own reverse-domain prefix.
APP_DISPLAY_NAME = Steppa
BUNDLE_ID_PREFIX = com.nickcia
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).runcoach

// Your Apple Developer team ID (needed for running on a device, iCloud and HealthKit).
DEVELOPMENT_TEAM =

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
