<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used instead of Info.plist when ENABLE_ICLOUD = YES (keep the two in step). UIBackgroundModes lets CloudKit's silent pushes
	     wake the app so changes from other devices sync in the background. -->
	<key>IntervalsClientID</key>
	<string>$(INTERVALS_CLIENT_ID)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Strava (see Config/App.xcconfig). The URL scheme brings the athlete back from the Strava app's Authorize screen. -->
	<key>StravaClientID</key>
	<string>$(STRAVA_CLIENT_ID)</string>
	<key>StravaClientSecret</key>
	<string>$(STRAVA_CLIENT_SECRET_NO_SERVER)</string>
	<!-- TrackStar's server, for Garmin Connect and Strava sign-in (see Config/App.xcconfig). -->
	<key>TrackStarServer</key>
	<string>$(TRACKSTAR_SERVER)</string>
	<key>StravaCallbackDomain</key>
	<string>$(STRAVA_CALLBACK_DOMAIN)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>strava</string>
	</array>
	<!-- Guided runs: spoken cues and tracking keep going with the screen locked, with a Live Activity on the lock screen. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<!-- Shared workouts: a .trackstar file opens in TrackStar. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>TrackStar workout</string>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).workout</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>trackstar</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.trackstar.workout+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>TrackStar workout</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).workout</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Save a run's share image to Photos (add-only). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Saves your run's share image to your photo library, so you can add it to Strava or post it.</string>
</dict>
</plist>
